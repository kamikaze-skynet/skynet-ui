# Cloudflare Pages header rules for skynetui.com
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Everything is public and safe to embed cross-origin
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# "Latest" files — short cache so new releases roll out within the hour
/skynet-ui.css
  Cache-Control: public, max-age=3600
/skynet-ui.js
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600

# Pinned version folders never change once published — cache forever
/v*
  Cache-Control: public, max-age=31536000, immutable
